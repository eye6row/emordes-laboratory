      "n": "001",
      "title": "Algae Yarn",
      "fiber": "Sodium alginate / glycerin",
      "gsm": 160,
      "finish": "Glossy, flexible strand",
      "origin": "Studio-made",
      "tags": [
        "biomaterial",
        "yarn"
      ],
      "description": "Seaweed-derived alginate yarn, hand extrusion, naturally dyed with spirulina powder\n\nNote: This particular formulation had more water to achieve a thinner viscosity, resulting in a thinner extrusion.",
      "year": "2026",
      "recipes": [
        {
          "title": "Yarn Recipe",
          "rows": [
            {
              "ingredient": "Sodium Alginate",
              "amount": "15g (~2 tbsp)"
            },
            {
              "ingredient": "Powder Dye",
              "amount": "1 tsp"
            },
            {
              "ingredient": "Glycerin",
              "amount": "30 g (50g if adding powder dye)"
            },
            {
              "ingredient": "Water",
              "amount": "500 mL"
            }
          ]
        },
        {
          "title": "Extrusion Bath Recipe",
          "rows": [
            {
              "ingredient": "Calcium Chloride",
              "amount": "40 g"
            },
            {
              "ingredient": "Water",
              "amount": "2 L"
            }
          ]
        }

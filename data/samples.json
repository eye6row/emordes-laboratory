      "n": "001",
      "title": "Algae Yarn",
      "fiber": "Sodium alginate / glycerin",
      "gsm": 160,
      "finish": "Glossy, flexible strand",
      "origin": "Studio-made",
      "tags": [
        "biomaterial",
        "yarn"
      ],
      "description": "Seaweed-derived alginate yarn, hand extrusion, naturally dyed with spirulina powder\n\nNote: This particular formulation had more water to achieve a thinner viscosity, resulting in a thinner extrusion.",
